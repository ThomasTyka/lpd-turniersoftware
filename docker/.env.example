# Copy to docker/.env and fill in real values. docker/.env is gitignored.
# Generate values with scripts/generate-auth-secrets.cs - see docker/README.md.

Auth__Username=admin
Auth__PasswordHash=
Auth__JwtSigningKey=

# This machine's LAN IP (e.g. 192.168.1.42) - needed for QR-pairing/link
# codes to work, since the container can't auto-detect the host's real
# network address. Find it with `ipconfig` (Windows) or `ifconfig`/`ip a`
# (Linux/Mac), the adapter connected to your LAN/Wi-Fi.
Server__LanAddress=
